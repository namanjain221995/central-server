# ---------------------------------------------------------------------------
# Entry point for the containerised deployment. The routes themselves live in
# site.conf; this file only decides which certificate answers which name.
#
# TLS is not optional here. The session cookie is __Host-/Secure, so a browser
# discards it over plain HTTP and nobody can sign in.
#
# TWO HTTPS server blocks, and the split is the point:
#
#   default_server   the LAN address, with the LOCAL-CA certificate. A client
#                    that connects by IP sends no SNI and lands here. Agents
#                    already enrolled against that address trust that CA and
#                    nothing else, so this block must keep answering exactly as
#                    it always has - swapping its certificate would cut every
#                    one of them off.
#
#   ${SERVER_NAME}   the public name, with the certificate named by TLS_CERT /
#                    TLS_KEY. In Let's Encrypt mode that is a publicly trusted
#                    certificate, which is what a Release build of the agent
#                    needs: it validates against the machine trust store and has
#                    no override. In self-signed mode both variables point at
#                    the local-CA files and the two blocks are equivalent.
#
# Rendered by the nginx image's envsubst at container start. Only variables set
# in the container's environment are substituted, which is why the nginx runtime
# variables in site.conf are safe there and why that file is not a template.
# ---------------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};
    server_tokens off;

    # Served over plain HTTP deliberately: a machine that does not trust the
    # local CA yet has to be able to fetch it.
    location = /endpoint-platform-ca.crt {
        root /etc/nginx/tls;
        default_type application/x-x509-ca-cert;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# The LAN address, and anything else that arrives without a recognised name.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/tls/server.crt;
    ssl_certificate_key /etc/nginx/tls/server.key;

    include /etc/nginx/snippets/site.conf;
}

# The public name.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};

    include /etc/nginx/snippets/site.conf;
}
