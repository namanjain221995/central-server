# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# The dashboard, and the single public entry point in front of it.
#
# One container serves the static build AND proxies /api/ and /agent/, because
# the session cookie is __Host- prefixed with Secure and SameSite=Strict: the
# browser pins it to exactly one origin, so the dashboard and the Admin API
# cannot live on different host names or ports. This mirrors what
# infra/ubuntu/setup-nginx.sh does on the native host.
#
# Build context is the REPOSITORY ROOT (the nginx config lives under deploy/).
# ---------------------------------------------------------------------------
FROM node:24-alpine AS build
WORKDIR /src
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci
COPY dashboard/ ./
RUN npm run build

FROM nginx:1.29-alpine AS runtime
# envsubst renders the template at container start, so the same image serves any
# host name and either kind of certificate.
COPY deploy/docker/nginx/default.conf.template /etc/nginx/templates/default.conf.template
# The shared routes are copied, not rendered: they contain only nginx runtime
# variables, which envsubst must never see.
COPY deploy/docker/nginx/site.conf /etc/nginx/snippets/site.conf
COPY --chmod=0755 deploy/docker/nginx/40-reload-certificates.sh /docker-entrypoint.d/40-reload-certificates.sh
COPY --from=build /src/dist /usr/share/nginx/html
# Defaults for a stack with no public name: both HTTPS blocks then serve the
# local-CA certificate. The compose file overrides all three.
ENV SERVER_NAME=_     TLS_CERT=/etc/nginx/tls/server.crt     TLS_KEY=/etc/nginx/tls/server.key
EXPOSE 80 443
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD wget -qO- --no-check-certificate https://127.0.0.1/healthz >/dev/null || exit 1
