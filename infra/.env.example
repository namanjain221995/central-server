# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT configuration, read by scripts/run-local.ps1.
#
#   cp infra/.env.example infra/.env
#
# then replace EVERY "CHANGE_ME" below with a freshly generated value. There are
# no defaults: a default password that "works out of the box" is a default
# password that reaches production.
#
# This file is for a DEVELOPER MACHINE only. PostgreSQL and Redis are installed
# natively there and must already be running; see docs/development.md. Nothing
# here runs in a container.
#
# The DEPLOYED Ubuntu host does not use this file at all. It generates its own
# secrets into /etc/endpoint-platform/secrets.env (root-only, 0600) on first
# install, and renders one environment file per service from them. See
# infra/ubuntu/README.md.
#
# Generate a value with (Windows PowerShell 5.1 or PowerShell 7+):
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $b = New-Object byte[] 24; $rng.GetBytes($b)
#   [Convert]::ToBase64String($b) -replace '[+/=]',''
#
# (The shorter [RandomNumberGenerator]::GetBytes(24) static exists only on
#  .NET Core / PowerShell 7+, not on Windows PowerShell 5.1.)
#
# infra/.env is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# --- PostgreSQL -------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=endpoint_platform

# The EXISTING PostgreSQL superuser, used by run-local.ps1 only to create the
# database and the two roles below (the same SQL the Ubuntu host runs). The
# application never connects as this role.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_postgres_superuser

# Owner role. Owns the schema. Used ONLY by the migration job.
POSTGRES_SUPERUSER=endpoint_owner
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_owner

# Restricted runtime role. Used by the Admin API and the Agent API.
# Holds no DDL rights, and only INSERT/SELECT on the audit table.
POSTGRES_APP_USER=endpoint_app
POSTGRES_APP_PASSWORD=CHANGE_ME_app

# --- Redis ------------------------------------------------------------------
#
# Redis 6.2 or later: redeeming a one-time secret uses GETDEL.
#
# Set `requirepass` on your local Redis to this value. Running it without a
# password is not supported here, for the same reason the deployed host always
# sets one: an unauthenticated Redis is a well-known foothold, and a local
# habit is the one that reaches a server.

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis

# --- Secret protection ------------------------------------------------------
#
# Seals the short-lived secrets (new/reset local Windows account passwords) that
# the Admin API hands to the Agent API through Redis. The Admin API SEALS with
# this key and the Agent API REDEEMS with it, so BOTH processes must be given the
# SAME value. Different values fail at redemption time - the create-user task
# reports "the ephemeral secret could not be unsealed" - not at startup.
#
# Must be a base64-encoded 32-byte (256-bit) key. Generate one with:
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $b = New-Object byte[] 32; $rng.GetBytes($b); [Convert]::ToBase64String($b)
#
# Maps to ENDPOINTPLATFORM_SecretProtection__Key for the API processes.
# Rotating it only invalidates in-flight secrets, which fail safely and can be
# re-issued; it does not affect stored data.

SECRET_PROTECTION_KEY=CHANGE_ME

# --- BitLocker recovery-key escrow ------------------------------------------
#
# Only needed locally if you are working on escrow. The Admin API refuses to
# start without it once escrow is exercised; see docs/runbooks/escrow-sealing-key.md
# and infra/ubuntu/gen-env.sh for what the deployed host generates.
#
# Must be a base64-encoded 32-byte (256-bit) key.

RECOVERY_ESCROW_KEY=CHANGE_ME
RECOVERY_ESCROW_KEY_VERSION=1
