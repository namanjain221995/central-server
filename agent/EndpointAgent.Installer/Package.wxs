<?xml version="1.0" encoding="utf-8"?>

<!--
  Endpoint Platform Agent installer.

  Produces EndpointPlatformAgent-<version>-x64.msi. Installs the self-contained
  agent, registers it as a Windows Service that starts automatically and recovers
  from crashes, and creates an ACL-protected state directory under ProgramData.

  Deliberately NOT in this package:
    - any enrollment token, credential or other secret. The MSI is a common,
      universal binary: it is identical for every machine and every customer, so
      it can be cached, mirrored and signed once. Enrolment happens after
      install, gated by an administrator approving the machine in the dashboard.
    - a UI wizard. Windows Installer's built-in progress is enough for a
      double-click install and leaves no console window behind.

  The published agent directory is passed in as $(AgentPublishDir) by the build.
-->

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Endpoint Platform Agent"
           Manufacturer="Endpoint Platform"
           Version="$(var.ProductVersion)"
           UpgradeCode="8f3c1d92-6b74-4a5e-9d21-7c4e8b0f5a63"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">

    <!--
      Same UpgradeCode across versions, so installing 1.1.0 over 1.0.0 is an
      upgrade rather than a second copy.

      The old version is removed AFTER the new one is installed (afterInstallExecute),
      not before. Costing runs before either placement, and it skips every component
      whose file on disk has a higher version than the one in this package. With the
      removal scheduled first, those files were then deleted along with the old
      version and never put back: an upgrade built with an older .NET runtime patch
      (10.0.11 over 10.0.12) installed 68 of ~253 files, the service could not start
      (hostpolicy.dll missing) and the failed upgrade left no agent at all. Removed
      last, a component both versions share is kept by reference counting, so a
      skipped file stays where it is.

      This depends on component GUIDs being stable, which they are: the service
      executable and the state components carry fixed GUIDs, and the <Files> glob
      derives each GUID from the file's path. For the same reason the service is
      registered once - its component is shared, so the old version's removal does
      not delete it.
    -->
    <MajorUpgrade
      Schedule="afterInstallExecute"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of the Endpoint Platform Agent is already installed." />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- x64 only: the agent P/Invokes 64-bit Windows account-management APIs. -->
    <Launch Condition="VersionNT64" Message="The Endpoint Platform Agent requires 64-bit Windows." />

    <!-- Windows 10 1809 / Server 2019 or later. -->
    <Launch Condition="Installed OR (VersionNT &gt;= 603)"
            Message="The Endpoint Platform Agent requires Windows 10 or Windows Server 2016 or later." />

    <Property Id="ARPHELPLINK" Value="https://github.com/omdevsinhsarvaiya-art/endpoint-management-platform" />

    <!--
      The management server the agent talks to. Not a secret: it is a public URL,
      so it is baked at build time rather than delivered as a per-download
      artifact. An administrator can still override it for another deployment
      with `msiexec /i ... SERVERBASEURL=https://…`, which is documented but not
      required for the normal double-click install.
    -->
    <Property Id="SERVERBASEURL" Value="$(var.ServerBaseUrl)" Secure="yes" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Feature Id="Main" Title="Endpoint Platform Agent" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AgentBinaries" />
      <ComponentGroupRef Id="AgentServiceComponents" />
      <ComponentGroupRef Id="AgentStateComponents" />
      <ComponentGroupRef Id="SessionNoticeComponents" />
      <ComponentGroupRef Id="CompanyPortalComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="CompanyFolder" Name="EndpointPlatform">
        <Directory Id="INSTALLFOLDER" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEFOLDER" Name="EndpointPlatformAgent">
        <Directory Id="LOGFOLDER" Name="Logs" />
      </Directory>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <!--
      Service registration lives on the executable's own component, which is what
      Windows Installer requires: the ServiceInstall is keyed to the file it runs.
    -->
    <ComponentGroup Id="AgentServiceComponents">
      <Component Id="AgentServiceExe" Directory="INSTALLFOLDER" Bitness="always64" Guid="2b7a4e18-9c33-4f60-8a15-3d6e2f9b4c71">
        <File Id="EndpointAgentServiceExe"
              Source="$(var.AgentPublishDir)\EndpointAgent.Service.exe"
              KeyPath="yes" />

        <ServiceInstall Id="AgentServiceInstall"
                        Name="EndpointPlatformAgent"
                        DisplayName="Endpoint Platform Agent"
                        Description="Reports inventory to the Endpoint Platform management server and applies management tasks it authorises. Communicates outbound over HTTPS only."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Vital="yes">

          <!--
            LocalSystem is required, not convenience: creating and modifying local
            Windows accounts through netapi32 needs administrative privilege. The
            server still authorises every action; the service decides nothing on
            its own.
          -->

          <!--
            Restart on crash, with a widening gap, and reset the counter daily.
            Without this a transient fault leaves an endpoint silently unmanaged
            until someone notices it stopped reporting.
          -->
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1" />

          <!--
            No DelayedAutoStart. The MSI ServiceConfig table that would carry it is
            documented by the Windows Installer SDK as "not [working] as expected",
            and the problem it solves - starting before the network stack is ready -
            is already handled properly: HeartbeatLoop retries with exponential
            backoff from 30s to 5min, so an early start costs one retry, not a
            failed enrolment.
          -->
        </ServiceInstall>

        <!-- Start on install and upgrade; stop and remove on uninstall. -->
        <ServiceControl Id="AgentServiceControl"
                        Name="EndpointPlatformAgent"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />

        <!-- Event Log source, so the service can write warnings where an
             administrator already looks. Created here because registering a
             source needs privileges the running service should not have. -->
        <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\EndpointPlatformAgent">
          <RegistryValue Type="string" Name="EventMessageFile"
                         Value="[NETFRAMEWORK]v4.0.30319\EventLogMessages.dll" />
          <RegistryValue Type="integer" Name="TypesSupported" Value="7" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AgentStateComponents">
      <!--
        ProgramData inherits an ACE granting BUILTIN\Users write access. The agent's
        state directory holds the DPAPI-protected device credential and the machine
        configuration, so inheritance is broken and the DACL replaced with SYSTEM +
        Administrators only.
      -->
      <!--
        Deliberately NO RemoveFolderEx here. The state directory holds the
        device credential and enrollment identity, and a major upgrade runs the
        OLD product's uninstall — so any uninstall-time folder removal destroys
        the machine's identity in the middle of every upgrade (this is exactly
        what the 1.0.0 installer did). The state directory therefore survives
        both upgrade and uninstall; removing a machine from management is a
        server-side retire (which revokes the credential), and the on-disk
        residue is DPAPI-protected, ACL'd to SYSTEM/Administrators, and useless
        once revoked. Manual cleanup: delete C:\ProgramData\EndpointPlatformAgent.
      -->
      <Component Id="AgentStateFolder" Directory="STATEFOLDER" Bitness="always64" Guid="6d1f8c47-2e59-4b83-9a07-5f3c8e1d2b94">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointPlatform\Agent"
                       Name="StateDirectory" Type="string" Value="[STATEFOLDER]" KeyPath="yes" />
      </Component>

      <Component Id="AgentLogFolder" Directory="LOGFOLDER" Bitness="always64" Guid="9c4b2a06-7d18-4e52-b3f9-1a8d6c5e0f37">
        <CreateFolder>
          <util:PermissionEx User="SYSTEM" GenericAll="yes" />
          <util:PermissionEx User="Administrators" GenericAll="yes" />
        </CreateFolder>
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointPlatform\Agent"
                       Name="LogDirectory" Type="string" Value="[LOGFOLDER]" KeyPath="yes" />
      </Component>

      <!--
        Machine-wide configuration. Written by the installer so the service knows
        which management server to contact; read after appsettings.json and
        overridden only by environment variables. Contains NO secret - the server
        URL is public information.
      -->
      <Component Id="AgentMachineConfig" Directory="STATEFOLDER" Bitness="always64" Guid="4a9e7f21-8b36-4c94-a5d2-0e7f1b3c6d85">
        <File Id="AgentConfigJson" Name="agent.config.json" Source="agent.config.json" KeyPath="yes" />
      </Component>

      <!--
        The server URL this install was given: the baked default, or SERVERBASEURL on
        the command line. The agent reads it after agent.config.json, so it wins over
        the baked file. Self-update passes the URL the running agent already uses, so
        against. Rewritten by every install and upgrade: Windows Installer's default
        reinstall mode ("m") rewrites a component's HKLM values, so a shared
        component does not keep an older version's URL.

        Before this value existed, SERVERBASEURL was declared but read by nothing:
        the documented command-line override had no effect.
      -->
      <Component Id="AgentServerUrl" Directory="STATEFOLDER" Bitness="always64" Guid="c3e8a5d1-6f42-4b97-8e20-9d1a7b4f2c63">
        <RegistryValue Root="HKLM" Key="SOFTWARE\EndpointPlatform\Agent"
                       Name="ServerBaseUrl" Type="string" Value="[SERVERBASEURL]" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="CompanyPortalComponents">
      <!--
        The Company Portal is a Start-menu entry and nothing more: the employee
        opens it, the service never starts it (ADR-0005, Company Portal
        amendment). The executable and the desktop runtime it needs come from the
        globbed publish folder; this component carries only the shortcut.

        A non-advertised shortcut, so clicking it runs the program directly rather
        than through Windows Installer's feature check. Windows Installer wants a
        per-user key path for such a shortcut (ICE43); the marker value under
        HKCU is that key path and nothing reads it. For an upgrade run by the
        agent itself the "current user" is SYSTEM, which is harmless: the
        shortcut still lands in the all-users Start menu, which is what matters.
      -->
      <Component Id="CompanyPortalShortcut" Directory="INSTALLFOLDER" Bitness="always64" Guid="a3f1c7d9-2e84-4b6a-9c05-6d1f8e2b7a40">
        <Shortcut Id="CompanyPortalStartMenu"
                  Directory="ProgramMenuFolder"
                  Name="Company Portal"
                  Description="Install apps approved by IT"
                  Target="[INSTALLFOLDER]EndpointAgent.CompanyPortal.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\EndpointPlatform\Agent"
                       Name="CompanyPortalShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="SessionNoticeComponents">
      <!--
        Starts the session notifier in every signed-in user's session, as that user,
        at sign-in. Windows does the starting, from the machine Run key. A user who is
        already signed in when this package installs or upgrades does not wait for a
        sign-in: the service, when it starts (ServiceControl Start below), starts the
        notifier in every session that has none, through one pinned
        CreateProcessAsUser call (ADR-0005, session-notice amendment). A second copy
        in the same session exits at once, so the two starters never leave two.

        HKLM, not HKCU: only an administrator can write it, so an ordinary user cannot
        point it somewhere else. The executable it names lives in the install folder,
        which is likewise administrator-only. The value is quoted because the path
        contains spaces; an unquoted path with spaces is the classic way to have
        Windows run something other than what was intended.

        Upgrades: the notifier shares the runtime files with the service. It exits when
        the service stops (which this package does before touching a file) and closes
        when Restart Manager asks, so the files are free to replace and the install
        needs no reboot.

        The executable itself is packaged by AgentBinaries.wxs, which globs the publish
        folder; this component carries only the registry value, as its key path.
      -->
      <Component Id="SessionNoticeAutostart" Directory="INSTALLFOLDER" Bitness="always64" Guid="7e2c9a41-5f38-4b16-9d07-c3a8e6f1b254">
        <RegistryValue Root="HKLM"
                       Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
                       Name="EndpointPlatformSessionNotice"
                       Type="string"
                       Value="&quot;[INSTALLFOLDER]EndpointAgent.SessionNotice.exe&quot;"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
