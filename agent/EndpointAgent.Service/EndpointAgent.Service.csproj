<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>EndpointAgent.Service</RootNamespace>
    <AssemblyName>EndpointAgent.Service</AssemblyName>
    <UserSecretsId>endpoint-agent-service</UserSecretsId>
    <VersionPrefix>1.15.0</VersionPrefix>

    <!--
      Self-contained: the endpoint must not need the .NET runtime installed. An
      administrator double-clicking an MSI cannot be asked to install a runtime
      first, so the publish carries its own.

      NOT trimmed. Trimming strips types that WMI (System.Management) and the DI
      container resolve reflectively; the failure would appear at runtime on a
      customer machine as a missing collector, not at build time here.
    -->
    <RuntimeIdentifier Condition="'$(PublishAgent)' == 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(PublishAgent)' == 'true'">true</SelfContained>
    <PublishTrimmed Condition="'$(PublishAgent)' == 'true'">false</PublishTrimmed>
    <PublishSingleFile Condition="'$(PublishAgent)' == 'true'">false</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!--
      Windows Service host. Composition root only: DI wiring, configuration,
      logging, and hosted services. No business logic, no Windows API calls.
      Runs as LocalSystem in production - treat as a privileged security boundary.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.EventLog" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EndpointAgent.Core\EndpointAgent.Core.csproj" />
    <ProjectReference Include="..\EndpointAgent.Windows\EndpointAgent.Windows.csproj" />
  </ItemGroup>

</Project>
