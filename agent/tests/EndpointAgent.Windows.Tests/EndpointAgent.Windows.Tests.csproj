<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EndpointAgent.Windows.Tests</RootNamespace>
    <AssemblyName>EndpointAgent.Windows.Tests</AssemblyName>
    <!--
      Windows integration tests. These exercise real Windows APIs and therefore
      only run on Windows. Tests that require elevation are marked with the
      [RequiresElevation] trait and skip themselves when not elevated, rather
      than failing, so the suite stays green in unelevated CI.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EndpointAgent.Windows\EndpointAgent.Windows.csproj" />
    <!--
      The real notifier executable, so the launcher tests start the genuine
      program in the test's own session (as the test user, on the real desktop,
      through the same CreateProcessAsUser call the service makes) and prove it
      is single-instance and yields to Restart Manager.
    -->
    <ProjectReference Include="..\..\EndpointAgent.SessionNotice\EndpointAgent.SessionNotice.csproj" />
  </ItemGroup>

</Project>
