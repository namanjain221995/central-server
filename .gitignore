# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json.sample
.idea/
*.swp

# ---------------------------------------------------------------------------
# Node / dashboard
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Agent build / installer output
#
# build/ holds shared MSBuild props that ARE tracked, so this ignores only the
# generated subdirectories: the self-contained publish (~83 MB) and the MSI.
# Installers are distributed through GitHub Releases, never committed.
# ---------------------------------------------------------------------------
build/agent-publish/
build/installer/
*.msi
*.wixpdb
# Generated from agent.config.json.template at MSI build time with the target
# server URL. Committing it would let the checked-in copy drift from whatever
# the last build actually produced.
agent/EndpointAgent.Installer/agent.config.json

# ---------------------------------------------------------------------------
# Test output
# ---------------------------------------------------------------------------
TestResults/
*.trx
*.coverage
*.coverlet.json

# ---------------------------------------------------------------------------
# Secrets and local configuration -- NEVER COMMIT
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# Certificates / private keys / credential material
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer
*.jks
*.keystore
certs/
!certs/.gitkeep

# Agent runtime state (contains device credential material)
agent-state/
*.agentcred

# ---------------------------------------------------------------------------
# Deployment build output
#
# infra/ubuntu/deploy.sh publishes here before installing to
# /opt/endpoint-platform on the target machine.
# ---------------------------------------------------------------------------
artifacts/publish/

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.package-content/

# ---------------------------------------------------------------------------
# Container deployment (deploy/docker)
#
# .env is the complete secret set for a deployment; tls/ holds the private key
# of the local CA and of the server certificate; pgpass holds the owner
# database password in clear text. None of the three belongs in the repository.
# ---------------------------------------------------------------------------
deploy/docker/.env*
deploy/docker/tls/
deploy/docker/pgadmin/pgpass
deploy/docker/pgadmin/servers.json
