<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EndpointPlatform.AgentApi.Tests</RootNamespace>
    <AssemblyName>EndpointPlatform.AgentApi.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AgentApi\EndpointPlatform.AgentApi.csproj" />
    <ProjectReference Include="..\..\Migrations\EndpointPlatform.Migrations.csproj" />
    <!--
      Test-only. The end-to-end test drives the real agent-side gate and sealer
      against the real Agent API host, so the one thing faked is the Windows call
      that would need an encrypted volume. ArchitectureTests inspects production
      assemblies only; neither API gains a reference to the agent.
    -->
    <ProjectReference Include="..\..\..\agent\EndpointAgent.Core\EndpointAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- How a test reaches the locally installed PostgreSQL. Linked rather than
         referenced so this project does not depend on another test assembly. -->
    <Compile Include="..\EndpointPlatform.Infrastructure.Tests\TestInfrastructure.cs" Link="TestInfrastructure.cs" />
  </ItemGroup>

</Project>
