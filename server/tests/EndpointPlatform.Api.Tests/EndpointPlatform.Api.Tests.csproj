<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EndpointPlatform.Api.Tests</RootNamespace>
    <AssemblyName>EndpointPlatform.Api.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Api\EndpointPlatform.Api.csproj" />
    <ProjectReference Include="..\..\Migrations\EndpointPlatform.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory signing authority used to exercise the publish gate. Linked
         rather than referenced so this project does not depend on another test
         assembly; one file, one definition of what a signed test artifact is. -->
    <Compile Include="..\EndpointPlatform.Infrastructure.Tests\Agents\TestArtifacts.cs" Link="Agents\TestArtifacts.cs" />
    <Compile Include="..\EndpointPlatform.Infrastructure.Tests\Agents\RealAgentMsiFactAttribute.cs" Link="Agents\RealAgentMsiFactAttribute.cs" />
    <!-- How a test reaches the locally installed PostgreSQL and Redis. Linked for the
         same reason: one definition, and no dependency on another test assembly. -->
    <Compile Include="..\EndpointPlatform.Infrastructure.Tests\TestInfrastructure.cs" Link="TestInfrastructure.cs" />
  </ItemGroup>

</Project>
